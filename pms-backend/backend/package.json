{
  "name": "pms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacy Management System - backend (NestJS, PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node --env-file-if-exists=.env -r ts-node/register src/database/migrate-cli.ts",
    "seed": "node --env-file-if-exists=.env -r ts-node/register src/seed/seed-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand && jest --runInBand --config test/jest-e2e.json",
    "test:unit": "jest --runInBand --testPathPattern=src",
    "test:e2e": "jest --runInBand --config test/jest-e2e.json",
    "demo-data": "node --env-file-if-exists=.env -r ts-node/register scripts/demo-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@types/multer": "^2.3.0",
    "@types/pdfkit": "^0.17.7",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
