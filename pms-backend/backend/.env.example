NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pms:change_me@localhost:5432/pms_dev
DB_POOL_MAX=10
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_value_please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# The next four are only first-run defaults; administrators change them in Settings afterwards
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_TTL_MINUTES=30
PERMISSION_CACHE_TTL_MS=15000
SETTINGS_CACHE_TTL_MS=5000
THROTTLE_LOGIN_LIMIT=10
# Where product images are stored (must be writable, outside any public web folder)
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# Used only by `npm run seed` to create the first System Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Number of reverse proxies (nginx, a load balancer) in front of the API; 0 when clients connect directly
TRUST_PROXY=0
# Set to false on all but one instance if you ever run more than one copy; background checks then run on that one only
JOBS_ENABLED=true
