# ==============================================================================
# Git Ignore - Pharmacy Management System (PMS)
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production and test build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
*.tsbuildinfo
**/*.tsbuildinfo

# Environment variables, credentials, and local configurations
# (Keeps secrets safe from being committed to GitHub)
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!.env.*.example
!deploy/.env.production.example

# Runtime uploads, media, and local storage
uploads/
**/uploads/
!**/uploads/.gitkeep
storage/
**/storage/
tmp/
temp/
*.sqlite
*.sqlite3
*.db

# Backups and archive artifacts
backup/
review/
sample-data/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak

# Testing and coverage
coverage/
**/coverage/
.nyc_output/

# Logs and diagnostic traces
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE and Editor configurations
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

